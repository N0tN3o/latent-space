# ============================================================================
# Latent Space Environment Variables (Optional — can also be set in /admin UI)
# Copy this file to .env or analysis_watcher/.env
# ============================================================================

# --- Cloud AI Provider Keys (set whichever provider you choose to use) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: ElevenLabs TTS ---
API_KEY=

# --- Optional: Legacy BUas AI Server ---
ACCESS_TOKEN=
USER_KEY=

# --- Optional: Server Port & Admin Passcode ---
PORT=8000
# If unset, a random passcode is auto-generated in config/admin_pin.txt on startup
LATENT_SPACE_ADMIN_PASSWORD=
